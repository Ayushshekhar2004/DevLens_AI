DB_HOST=localhost
DB_PORT=5432
DB_NAME=devlens
DB_USERNAME=your_postgres_user
DB_PASSWORD=replace_with_your_local_password
SERVER_PORT=8080
FRONTEND_ORIGIN=http://localhost:5173

# AI_PROVIDER may be auto, mock, or openai-compatible. Auto uses mock when AI_API_KEY is blank.
AI_PROVIDER=mock
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1/
AI_MODEL=gpt-4.1-mini
AI_TIMEOUT_SECONDS=30

# Opt in with AI_PROVIDER=ollama and set OLLAMA_MODEL to a model already installed.
# Profile entries: id|display name|trusted URL, comma-separated. Use private IP literals for LAN.
# For Docker on Mac, explicitly set local to http://host.docker.internal:11434.
OLLAMA_PROFILES=local|This machine|http://localhost:11434
OLLAMA_DEFAULT_PROFILE=local
OLLAMA_MODEL=
OLLAMA_CONNECT_TIMEOUT_SECONDS=5
OLLAMA_READ_TIMEOUT_SECONDS=120
OLLAMA_OUTPUT_LIMIT=2048
OLLAMA_CONTEXT_BUDGET=8192

# Generate a random value with at least 32 bytes. Never commit a real secret.
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters_long
JWT_EXPIRATION_MINUTES=60
