# Copy this file to .env before running Docker Compose. Never commit the populated .env.
DB_NAME=devlens
DB_USERNAME=devlens
DB_PASSWORD=replace_with_a_strong_local_database_password
POSTGRES_PORT=5432

JWT_SECRET=replace_with_a_random_secret_at_least_32_characters_long
JWT_EXPIRATION_MINUTES=60

FRONTEND_PORT=5173
BACKEND_PORT=8080
FRONTEND_ORIGIN=http://localhost:5173

# The default / makes browser API calls use the frontend Nginx proxy.
VITE_API_BASE_URL=/

# Keep mock for a self-contained local stack. Configure a real provider only when needed.
AI_PROVIDER=mock
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1/
AI_MODEL=gpt-4.1-mini
AI_TIMEOUT_SECONDS=30

# Opt-in local Ollama. In Compose, localhost means the backend container itself.
# Use host.docker.internal for trusted host Ollama, or a private IP literal for trusted LAN.
OLLAMA_PROFILES=local|This machine|http://host.docker.internal:11434
OLLAMA_DEFAULT_PROFILE=local
OLLAMA_MODEL=
OLLAMA_CONNECT_TIMEOUT_SECONDS=5
OLLAMA_READ_TIMEOUT_SECONDS=120
OLLAMA_OUTPUT_LIMIT=2048
OLLAMA_CONTEXT_BUDGET=8192

# Private repository snapshot limits. Folder import is a disabled trusted admin/CLI flow.
REPOSITORY_ALLOWED_FOLDER_ROOT=/app/import-root
REPOSITORY_MAX_UPLOAD_BYTES=10485760
REPOSITORY_MAX_EXPANDED_BYTES=52428800
REPOSITORY_MAX_FILE_BYTES=1048576
REPOSITORY_MAX_FILES=2000
REPOSITORY_MAX_PATH_DEPTH=20
REPOSITORY_MAX_DECOMPRESSION_RATIO=100
REPOSITORY_MAX_ELAPSED_SECONDS=30
REPOSITORY_IMPORT_CLI_ENABLED=false
REPOSITORY_IMPORT_CLI_SOURCE=
REPOSITORY_IMPORT_CLI_OWNER_EMAIL=
REPOSITORY_SCAN_MAX_TEXT_BYTES=1048576
REPOSITORY_SCAN_MAX_MANIFEST_BYTES=262144
REPOSITORY_SCAN_MAX_SYMBOLS_PER_FILE=1000
REPOSITORY_SCAN_MAX_IMPORTS_PER_FILE=1000
REPOSITORY_WORKER_COUNT=2
REPOSITORY_QUEUE_CAPACITY=20
# 0 disables automatic retention deletion. Set a positive value only after reviewing the policy.
REPOSITORY_RETENTION_DAYS=0
REPOSITORY_CLEANUP_INTERVAL_HOURS=24
REPOSITORY_ANALYSIS_WORKERS=1
REPOSITORY_ANALYSIS_QUEUE_CAPACITY=4
REPOSITORY_ANALYSIS_INFERENCE_CONCURRENCY=1
REPOSITORY_ANALYSIS_CALL_TIMEOUT_SECONDS=120
REPOSITORY_ANALYSIS_JOB_DEADLINE_SECONDS=1800
REPOSITORY_ANALYSIS_MAX_CALLS=100
REPOSITORY_ANALYSIS_MAX_INPUT_TOKENS=100000
REPOSITORY_ANALYSIS_MAX_OUTPUT_TOKENS=204800
REPOSITORY_ANALYSIS_MAX_FILES=100
REPOSITORY_ANALYSIS_CONTEXT_TOKENS=8192
REPOSITORY_ANALYSIS_SYSTEM_RESERVE_TOKENS=768
REPOSITORY_ANALYSIS_SCHEMA_RESERVE_TOKENS=768
REPOSITORY_ANALYSIS_OUTPUT_RESERVE_TOKENS=2048
REPOSITORY_ANALYSIS_SAFETY_RESERVE_TOKENS=512
REPOSITORY_ANALYSIS_OVERLAP_LINES=3
