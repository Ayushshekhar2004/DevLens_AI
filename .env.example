# Copy this file to .env before running Docker Compose. Never commit the populated .env.
DB_NAME=devlens
DB_USERNAME=devlens
DB_PASSWORD=replace_with_a_strong_local_database_password
POSTGRES_PORT=5432

JWT_SECRET=replace_with_a_random_secret_at_least_32_characters_long
JWT_EXPIRATION_MINUTES=60

FRONTEND_PORT=5173
BACKEND_PORT=8080
FRONTEND_ORIGIN=http://localhost:5173

# The default / makes browser API calls use the frontend Nginx proxy.
VITE_API_BASE_URL=/

# Keep mock for a self-contained local stack. Configure a real provider only when needed.
AI_PROVIDER=mock
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1/
AI_MODEL=gpt-4.1-mini
AI_TIMEOUT_SECONDS=30
